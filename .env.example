# CargoChain — Environment Variables Template
# Copy this file to `.env` and fill in the values below.
# `.env` is gitignored. Never commit secrets.

# ----------------------------------------------------------------------------
# Frontend Public Environment Variables (VITE_ prefix required)
# ----------------------------------------------------------------------------
VITE_CHAT_API_URL=http://127.0.0.1:3000
VITE_SUPABASE_URL=<YOUR_SUPABASE_URL>
VITE_SUPABASE_PUBLISHABLE_KEY=<YOUR_SUPABASE_PUBLISHABLE_KEY>
VITE_CHAIN_ID=1337

VITE_IPFS_GATEWAY_URLS=<YOUR_IPFS_GATEWAY_URLS>

# ----------------------------------------------------------------------------
# Trusted Backend Server Secrets (DO NOT expose to frontend or commit)
# ----------------------------------------------------------------------------
SUPABASE_URL=<YOUR_SUPABASE_URL>
SUPABASE_SERVICE_ROLE_KEY=<YOUR_SUPABASE_SERVICE_ROLE_KEY>
SUPABASE_JWT_SECRET=<YOUR_SUPABASE_JWT_SECRET>


VITE_GANACHE_RPC_URL=http://127.0.0.1:7545
CLIENT_ORIGIN=http://127.0.0.1:5174

# Local Truffle/Ganache connection (defaults shown)
GANACHE_HOST=127.0.0.1
GANACHE_PORT=7545
GANACHE_NETWORK_ID=1337
GANACHE_DATABASE_PATH=ganache-data


# Pinata encrypted proof storage (Express only; never use VITE_ prefixes)
PINATA_JWT=<YOUR_PINATA_JWT>
PINATA_GATEWAY_HOST=<YOUR_PINATA_GATEWAY_HOST>
# 32 random bytes encoded as base64url (or 64 hexadecimal characters)
IPFS_MASTER_KEY=<YOUR_IPFS_MASTER_KEY>
