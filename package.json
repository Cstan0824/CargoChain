    "upload-server": "node server/upload-server.js",
    "frontend": "http-server src -p 8080 -c-1",
    "start": "node scripts/dev-launcher.js"
  },
  "dependencies": {
    "@truffle/hdwallet-provider": "^2.1.4",
    "express": "^4.19.2",
    "multer": "^1.4.5-lts.1",
    "truffle": "^5.11.5",
    "web3": "^1.10.0"
  },
  "devDependencies": {
    "ganache": "^7.9.2",
    "http-server": "^14.1.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
