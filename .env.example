# CargoChain — Environment Variables
#
# Copy this file to `.env` and fill in the values below.
# `.env` is gitignored. Never commit secrets.
#
# All four local services bind to 127.0.0.1 by default — no public exposure.
# If you need LAN access, pass `--host 0.0.0.0` on the command line, NOT in
# the npm scripts.

# ----------------------------------------------------------------------------
# Optional overrides (active in v1)
# ----------------------------------------------------------------------------

# Port for the photo upload server (default 3000).
UPLOAD_PORT=3000

# Vite dev server port (default 5173). The VITE_ prefix is required for the
# variable to be readable from the React bundle. Only use this prefix for vars
# safe to ship to the browser (VITE_* vars are inlined into the JS bundle).
# VITE_DEV_PORT=5173

# ----------------------------------------------------------------------------
# FUTURE PLAN — Sepolia testnet (NOT USED IN V1)
# ----------------------------------------------------------------------------
# The team has explicitly deferred Sepolia deployment. The block below is
# here only so the future PR is a one-line uncomment. To enable Sepolia:
#   1. Fill in SEPOLIA_RPC and TEAM_MNEMONIC below.
#   2. Uncomment the sepolia block in truffle-config.js.
#   3. Run: npx truffle migrate --network sepolia
# Do NOT fill these in or uncomment anything until the team agrees to ship v2.
# ----------------------------------------------------------------------------

# Alchemy or Infura HTTPS RPC for Sepolia. Free tier is fine.
# Example: https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY_HERE
SEPOLIA_RPC=

# Shared team BIP-39 mnemonic (12 or 24 words). Generates the deployer
# account + the 10 prefunded accounts everyone uses for testing.
# DO NOT use a wallet that holds real funds.
TEAM_MNEMONIC=
