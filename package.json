{
  "name": "cargochain",
  "version": "0.1.0",
  "private": true,
  "description": "CargoChain — Decentralised escrow and milestone-based logistics tracking DApp on Ethereum (BMIS2003 TARUMT Y3S1).",
  "scripts": {
    "dev": "vite",
    "dev:all": "concurrently -n upload,vite -c green,magenta \"node server/upload-server.js\" \"npm run dev\"",
    "chain": "ganache --wallet.deterministic --server.host 127.0.0.1 --server.port 7545 --chain.chainId 1337 --chain.networkId 1337",
    "build": "vite build",
    "preview": "vite preview --port 8080",
    "compile": "truffle compile",
    "migrate": "truffle migrate --reset --network development",
    "test": "truffle test",
    "test:scenarios": "truffle exec scripts/run-scenarios.js",
    "upload-server": "node server/upload-server.js",
    "start": "node scripts/dev-launcher.js"
  },
  "dependencies": {
    "@truffle/hdwallet-provider": "^2.1.4",
    "express": "^4.19.2",
    "multer": "^1.4.5-lts.1",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-router-dom": "^6.26.0",
    "truffle": "^5.11.5",
    "ethers": "^6.13.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.0.0",
    "dotenv": "^16.4.5",
    "ganache": "^7.9.2",
    "vite": "^5.4.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "author": "Cstan + Group (wx, GAN, Jeremy, Melissa)",
  "license": "UNLICENSED"
}
